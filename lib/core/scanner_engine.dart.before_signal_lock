import 'dart:async';
import 'dart:math';

import 'package:flutter/foundation.dart';

import '../feeds/feed_adapter.dart';
import '../models/scan_result.dart';
import '../models/tick.dart';
import 'asset_state.dart';

class SignalHistoryRecord {
  final String symbol;
  final SignalSide side;
  final int score;
  final double entryPrice;
  final double exitPrice;
  final DateTime entryTime;
  final DateTime exitTime;
  final String outcome;

  const SignalHistoryRecord({
    required this.symbol,
    required this.side,
    required this.score,
    required this.entryPrice,
    required this.exitPrice,
    required this.entryTime,
    required this.exitTime,
    required this.outcome,
  });
}

class _PendingSignal {
  final String symbol;
  final SignalSide side;
  final int score;
  final double entryPrice;
  final double entryTimestamp;
  final int minuteBucket;

  const _PendingSignal({
    required this.symbol,
    required this.side,
    required this.score,
    required this.entryPrice,
    required this.entryTimestamp,
    required this.minuteBucket,
  });
}

class ScannerEngine extends ChangeNotifier {
  final Map<String, AssetState> _assets = {};
  final Map<String, ScanResult> _results = {};

  final Map<String, _PendingSignal> _pendingSignals = {};
  final List<SignalHistoryRecord> _history = [];

  final Map<String, int> _winsByAsset = {};
  final Map<String, int> _lossesByAsset = {};
  final Map<String, int> _tiesByAsset = {};

  FeedAdapter? _feed;
  StreamSubscription<Tick>? _feedSub;
  Timer? _healthTimer;

  int totalTicks = 0;
  DateTime? lastTickAt;

  int wins = 0;
  int losses = 0;
  int ties = 0;

  String status = 'Disconnected';

  static const int staleLimitMs = 2500;
  static const int strongThreshold = 85;
  static const int entryThreshold = 70;

  ScannerEngine() {
    _healthTimer = Timer.periodic(
      const Duration(milliseconds: 500),
      (_) => _healthCheck(),
    );
  }

  List<ScanResult> get rankedResults {
    final list = _results.values.toList();

    list.sort((a, b) {
      final aAge = resultAgeMs(a.symbol);
      final bAge = resultAgeMs(b.symbol);

      final freshA = aAge <= staleLimitMs ? 1 : 0;
      final freshB = bAge <= staleLimitMs ? 1 : 0;

      if (freshA != freshB) {
        return freshB.compareTo(freshA);
      }

      return b.score.compareTo(a.score);
    });

    return list;
  }

  List<SignalHistoryRecord> get signalHistory =>
      List.unmodifiable(_history.reversed);

  int get assetCount => _assets.length;

  String get feedName => _feed?.name ?? 'None';

  bool get connected => _feed?.isConnected ?? false;

  int get resolvedSignals => wins + losses + ties;

  double get winRate {
    final decisive = wins + losses;

    if (decisive == 0) {
      return 0;
    }

    return wins / decisive * 100;
  }

  int get secondsRemaining {
    final nowSeconds = DateTime.now().millisecondsSinceEpoch ~/ 1000;

    final elapsed = nowSeconds % 60;

    final remaining = 60 - elapsed;

    return remaining == 60 ? 60 : remaining;
  }

  bool get feedFresh {
    if (lastTickAt == null) {
      return false;
    }

    return DateTime.now().difference(lastTickAt!).inMilliseconds <=
        staleLimitMs;
  }

  int resultAgeMs(String symbol) {
    final state = _assets[symbol];

    if (state == null || state.ticks.isEmpty) {
      return 999999;
    }

    final tick = state.ticks.last;

    final now = DateTime.now().millisecondsSinceEpoch;

    final tickMs = (tick.timestamp * 1000).round();

    return max(0, now - tickMs);
  }

  int assetWins(String symbol) => _winsByAsset[symbol] ?? 0;

  int assetLosses(String symbol) => _lossesByAsset[symbol] ?? 0;

  int assetTies(String symbol) => _tiesByAsset[symbol] ?? 0;

  double assetWinRate(String symbol) {
    final w = assetWins(symbol);
    final l = assetLosses(symbol);

    if (w + l == 0) {
      return 0;
    }

    return w / (w + l) * 100;
  }

  Future<void> useFeed(
    FeedAdapter adapter,
  ) async {
    await disconnect();

    _feed = adapter;

    status = 'Connecting to ${adapter.name}...';

    notifyListeners();

    try {
      await adapter.connect();

      _feedSub = adapter.ticks.listen(
        ingestTick,
        onError: (_) {
          status = 'Feed Error';
          notifyListeners();
        },
        onDone: () {
          status = 'Disconnected';
          notifyListeners();
        },
      );

      status = 'Connected — waiting for ticks';

      notifyListeners();
    } catch (_) {
      status = 'Connection Failed';
      notifyListeners();
    }
  }

  Future<void> disconnect() async {
    await _feedSub?.cancel();

    _feedSub = null;

    await _feed?.disconnect();

    status = 'Disconnected';

    notifyListeners();
  }

  void ingestTick(Tick tick) {
    if (tick.symbol.trim().isEmpty) {
      return;
    }

    if (tick.price <= 0) {
      return;
    }

    if (tick.timestamp <= 0) {
      return;
    }

    totalTicks++;

    lastTickAt = DateTime.now();

    status = 'LIVE — receiving ticks';

    final state = _assets.putIfAbsent(
      tick.symbol,
      () => AssetState(tick.symbol),
    );

    state.addTick(tick);

    _resolveExpiredSignal(
      state,
      tick,
    );

    final result = _scan(state, tick);

    _results[tick.symbol] = result;

    _maybeOpenSignal(
      state,
      result,
      tick,
    );

    notifyListeners();
  }

  void _maybeOpenSignal(
    AssetState state,
    ScanResult result,
    Tick tick,
  ) {
    if (result.side == SignalSide.wait) {
      return;
    }

    if (result.score < entryThreshold) {
      return;
    }

    if (resultAgeMs(result.symbol) > staleLimitMs) {
      return;
    }

    final minuteBucket = (tick.timestamp / 60).floor();

    final existing = _pendingSignals[result.symbol];

    if (existing != null && existing.minuteBucket == minuteBucket) {
      return;
    }

    _pendingSignals[result.symbol] = _PendingSignal(
      symbol: result.symbol,
      side: result.side,
      score: result.score,
      entryPrice: tick.price,
      entryTimestamp: tick.timestamp,
      minuteBucket: minuteBucket,
    );
  }

  void _resolveExpiredSignal(
    AssetState state,
    Tick currentTick,
  ) {
    final pending = _pendingSignals[state.symbol];

    if (pending == null) {
      return;
    }

    final elapsed = currentTick.timestamp - pending.entryTimestamp;

    if (elapsed < 60) {
      return;
    }

    String outcome;

    if ((currentTick.price - pending.entryPrice).abs() < 0.000000001) {
      outcome = 'TIE';
      ties++;
      _tiesByAsset.update(
        pending.symbol,
        (value) => value + 1,
        ifAbsent: () => 1,
      );
    } else {
      final wentUp = currentTick.price > pending.entryPrice;

      final won = pending.side == SignalSide.call ? wentUp : !wentUp;

      if (won) {
        outcome = 'WIN';
        wins++;

        _winsByAsset.update(
          pending.symbol,
          (value) => value + 1,
          ifAbsent: () => 1,
        );
      } else {
        outcome = 'LOSS';
        losses++;

        _lossesByAsset.update(
          pending.symbol,
          (value) => value + 1,
          ifAbsent: () => 1,
        );
      }
    }

    _history.add(
      SignalHistoryRecord(
        symbol: pending.symbol,
        side: pending.side,
        score: pending.score,
        entryPrice: pending.entryPrice,
        exitPrice: currentTick.price,
        entryTime: DateTime.fromMillisecondsSinceEpoch(
          (pending.entryTimestamp * 1000).round(),
        ),
        exitTime: DateTime.fromMillisecondsSinceEpoch(
          (currentTick.timestamp * 1000).round(),
        ),
        outcome: outcome,
      ),
    );

    if (_history.length > 1000) {
      _history.removeAt(0);
    }

    _pendingSignals.remove(
      state.symbol,
    );
  }

  void _healthCheck() {
    if (_feed == null) {
      return;
    }

    if (lastTickAt == null) {
      if (connected) {
        status = 'Connected — waiting for market data';
      }

      notifyListeners();
      return;
    }

    final age = DateTime.now().difference(lastTickAt!).inMilliseconds;

    if (age > staleLimitMs) {
      status = 'STALE FEED — WAIT';

      _refreshStaleResults();
    } else if (connected) {
      status = 'LIVE — receiving ticks';
    }

    notifyListeners();
  }

  void _refreshStaleResults() {
    for (final entry in _assets.entries) {
      final state = entry.value;

      if (state.ticks.isEmpty) {
        continue;
      }

      _results[entry.key] = _scan(
        state,
        state.ticks.last,
      );
    }
  }

  void clear() {
    _assets.clear();
    _results.clear();

    _pendingSignals.clear();
    _history.clear();

    _winsByAsset.clear();
    _lossesByAsset.clear();
    _tiesByAsset.clear();

    totalTicks = 0;

    wins = 0;
    losses = 0;
    ties = 0;

    lastTickAt = null;

    notifyListeners();
  }

  ScanResult _scan(
    AssetState state,
    Tick lastTick,
  ) {
    final closes = state.candles1s.map((c) => c.close).toList();

    final ema9 = _ema(closes, 9);

    final ema21 = _ema(closes, 21);

    final rsi = _rsi(closes, 14);

    double velocity = 0;

    if (state.ticks.length >= 2) {
      final start = state.ticks[max(0, state.ticks.length - 8)];

      final end = state.ticks.last;

      final dt = max(
        .001,
        end.timestamp - start.timestamp,
      );

      velocity = (end.price - start.price) / dt;
    }

    int call = 0;
    int put = 0;

    final reasons = <String>[];

    if (ema9 > ema21) {
      call += 24;
      reasons.add(
        'EMA9 > EMA21',
      );
    } else if (ema9 < ema21) {
      put += 24;
      reasons.add(
        'EMA9 < EMA21',
      );
    }

    if (velocity > 0) {
      call += 18;
      reasons.add(
        'tick velocity up',
      );
    } else if (velocity < 0) {
      put += 18;
      reasons.add(
        'tick velocity down',
      );
    }

    if (rsi >= 52 && rsi < 74) {
      call += 14;
      reasons.add(
        'RSI confirms upside',
      );
    } else if (rsi <= 48 && rsi > 26) {
      put += 14;
      reasons.add(
        'RSI confirms downside',
      );
    } else if (rsi >= 74 || rsi <= 26) {
      reasons.add(
        'RSI extreme',
      );
    }

    if (state.candles5s.length >= 3) {
      final recent = state.candles5s.sublist(
        state.candles5s.length - 3,
      );

      final move = recent.last.close - recent.first.open;

      if (move > 0) {
        call += 18;
        reasons.add(
          '5s momentum up',
        );
      } else if (move < 0) {
        put += 18;
        reasons.add(
          '5s momentum down',
        );
      }
    }

    if (state.candles15s.isNotEmpty) {
      final candle = state.candles15s.last;

      if (candle.bodyRatio > .55) {
        if (candle.body > 0) {
          call += 12;
          reasons.add(
            'strong 15s bullish body',
          );
        } else if (candle.body < 0) {
          put += 12;
          reasons.add(
            'strong 15s bearish body',
          );
        }
      }
    }

    if (state.candles1s.isNotEmpty && state.candles1s.last.ticks >= 2) {
      if (call > put) {
        call += 8;
      } else if (put > call) {
        put += 8;
      }

      reasons.add(
        'active tick flow',
      );
    }

    final ageMs = resultAgeMs(state.symbol);

    SignalSide side = SignalSide.wait;

    int score = min(100, max(call, put));

    final spread = (call - put).abs();

    if (ageMs > staleLimitMs) {
      side = SignalSide.wait;

      score = min(score, 40);

      reasons.add(
        'STALE FEED',
      );
    } else if (score >= 64 && spread >= 18) {
      side = call > put ? SignalSide.call : SignalSide.put;
    } else {
      side = SignalSide.wait;

      score = min(score, 63);

      reasons.add(
        'waiting for confirmation',
      );
    }

    return ScanResult(
      symbol: state.symbol,
      side: side,
      score: score,
      price: lastTick.price,
      source: lastTick.source,
      reason: reasons.take(5).join(' • '),
      ema9: ema9,
      ema21: ema21,
      rsi14: rsi,
      velocity: velocity,
      ageMs: ageMs,
    );
  }

  double _ema(
    List<double> values,
    int period,
  ) {
    if (values.isEmpty) {
      return 0;
    }

    final k = 2 / (period + 1);

    double ema = values.first;

    for (final value in values.skip(1)) {
      ema = (value * k) + (ema * (1 - k));
    }

    return ema;
  }

  double _rsi(
    List<double> values,
    int period,
  ) {
    if (values.length < 2) {
      return 50;
    }

    final start = max(
      1,
      values.length - period,
    );

    double gains = 0;
    double lossesLocal = 0;
    int count = 0;

    for (int i = start; i < values.length; i++) {
      final difference = values[i] - values[i - 1];

      if (difference >= 0) {
        gains += difference;
      } else {
        lossesLocal += -difference;
      }

      count++;
    }

    if (count == 0) {
      return 50;
    }

    final avgGain = gains / count;

    final avgLoss = lossesLocal / count;

    if (avgLoss == 0) {
      return 100;
    }

    final rs = avgGain / avgLoss;

    return 100 - (100 / (1 + rs));
  }

  @override
  void dispose() {
    _healthTimer?.cancel();
    _feedSub?.cancel();
    _feed?.disconnect();

    super.dispose();
  }
}
