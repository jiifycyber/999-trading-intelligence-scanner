import 'package:flutter/material.dart';

import '../core/scanner_engine.dart';
import '../feeds/browser_bridge_adapter.dart';
import '../feeds/demo_feed_adapter.dart';
import '../models/scan_result.dart';

class Dashboard extends StatefulWidget {
  const Dashboard({super.key});

  @override
  State<Dashboard> createState() => _DashboardState();
}

class _DashboardState extends State<Dashboard> {
  late final ScannerEngine engine;

  @override
  void initState() {
    super.initState();
    engine = ScannerEngine();
  }

  @override
  void dispose() {
    engine.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: engine,
      builder: (context, _) {
        final results = engine.rankedResults;
        final width = MediaQuery.sizeOf(context).width;
        final isMobile = width < 760;

        return Scaffold(
          appBar: AppBar(
            toolbarHeight: isMobile ? 78 : 64,
            title: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  '999 Trading Intelligence',
                  style: TextStyle(
                    fontWeight: FontWeight.w900,
                    fontSize: isMobile ? 21 : 24,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  isMobile
                      ? 'V2 • 60-Second Scanner • ${engine.assetCount} assets • ${engine.totalTicks} ticks'
                      : 'V2 • 60-Second Multi-Asset Scanner',
                  style: TextStyle(
                    fontSize: isMobile ? 11 : 12,
                    color: Colors.white70,
                  ),
                ),
              ],
            ),
            actions: isMobile
                ? null
                : [
                    Padding(
                      padding: const EdgeInsets.only(right: 16),
                      child: Center(
                        child: Text(
                          '${engine.assetCount} assets • ${engine.totalTicks} ticks',
                        ),
                      ),
                    ),
                  ],
          ),
          body: isMobile ? _buildMobile(results) : _buildDesktop(results),
        );
      },
    );
  }

  Widget _buildMobile(List<ScanResult> results) {
    return SingleChildScrollView(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          _feedPanel(),
          const Divider(height: 1),
          _agentPanel(results),
          const Divider(height: 1),
          if (results.isEmpty)
            const Padding(
              padding: EdgeInsets.symmetric(
                horizontal: 20,
                vertical: 48,
              ),
              child: Center(
                child: Text(
                  'Connect a feed to begin scanning.',
                  textAlign: TextAlign.center,
                  style: TextStyle(fontSize: 17),
                ),
              ),
            )
          else
            Padding(
              padding: const EdgeInsets.all(12),
              child: Column(
                children: [
                  for (int i = 0; i < results.length; i++) ...[
                    _ResultCard(result: results[i]),
                    if (i != results.length - 1) const SizedBox(height: 10),
                  ],
                ],
              ),
            ),
        ],
      ),
    );
  }

  Widget _buildDesktop(List<ScanResult> results) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        SizedBox(
          width: 340,
          child: SingleChildScrollView(
            child: Column(
              children: [
                _feedPanel(),
                _agentPanel(results),
              ],
            ),
          ),
        ),
        const VerticalDivider(width: 1),
        Expanded(
          child: results.isEmpty
              ? const Center(
                  child: Text(
                    'Connect a feed to begin scanning.',
                    style: TextStyle(fontSize: 18),
                  ),
                )
              : ListView.separated(
                  padding: const EdgeInsets.all(16),
                  itemCount: results.length,
                  separatorBuilder: (_, __) => const SizedBox(height: 10),
                  itemBuilder: (_, index) =>
                      _ResultCard(result: results[index]),
                ),
        ),
      ],
    );
  }

  Widget _feedPanel() {
    return Container(
      width: double.infinity,
      color: const Color(0xFF0B1018),
      padding: const EdgeInsets.all(18),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          const Text(
            'LIVE FEED',
            style: TextStyle(
              fontWeight: FontWeight.w900,
              letterSpacing: 1.2,
              fontSize: 18,
            ),
          ),
          const SizedBox(height: 14),
          _statusRow('Status', engine.status),
          _statusRow('Provider', engine.feedName),
          _statusRow('Assets', '${engine.assetCount}'),
          _statusRow('Ticks', '${engine.totalTicks}'),
          const SizedBox(height: 18),
          FilledButton.icon(
            onPressed: () => engine.useFeed(DemoFeedAdapter()),
            icon: const Icon(Icons.play_arrow),
            label: const Padding(
              padding: EdgeInsets.symmetric(vertical: 13),
              child: Text('Run Demo Feed'),
            ),
          ),
          const SizedBox(height: 10),
          FilledButton.tonalIcon(
            onPressed: () => engine.useFeed(BrowserBridgeAdapter()),
            icon: const Icon(Icons.sensors),
            label: const Padding(
              padding: EdgeInsets.symmetric(vertical: 13),
              child: Text('Connect Browser Bridge'),
            ),
          ),
          const SizedBox(height: 10),
          OutlinedButton.icon(
            onPressed: engine.disconnect,
            icon: const Icon(Icons.link_off),
            label: const Padding(
              padding: EdgeInsets.symmetric(vertical: 12),
              child: Text('Disconnect'),
            ),
          ),
          const SizedBox(height: 10),
          OutlinedButton.icon(
            onPressed: engine.clear,
            icon: const Icon(Icons.delete_outline),
            label: const Padding(
              padding: EdgeInsets.symmetric(vertical: 12),
              child: Text('Clear Scanner'),
            ),
          ),
          const SizedBox(height: 16),
          Text(
            'Feed processing uses sanitized quote data: '
            'symbol + timestamp + price.',
            style: TextStyle(
              fontSize: 11,
              color: Colors.white.withValues(alpha: .50),
            ),
          ),
        ],
      ),
    );
  }

  Widget _agentPanel(List<ScanResult> results) {
    final ScanResult? top = results.isEmpty ? null : results.first;

    String headline;
    String detail;

    if (top == null) {
      headline = 'WAITING FOR MARKET DATA';
      detail = 'Once a feed is connected, I will identify the strongest '
          'scanner setup, direction, confidence, entry conditions, '
          'and reasons to avoid a trade.';
    } else {
      headline = _recommendation(top);
      detail =
          '${top.symbol} • ${top.score}/100 • ${_setupQuality(top)} setup. '
          '${_entryGuidance(top)}';
    }

    return Container(
      width: double.infinity,
      margin: const EdgeInsets.all(12),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: const Color(0xFF181321),
        borderRadius: BorderRadius.circular(18),
        border: Border.all(
          color: const Color(0xFF8E63D8).withValues(alpha: .55),
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Row(
            children: [
              CircleAvatar(
                radius: 21,
                backgroundColor: Color(0xFF6C4BA5),
                child: Icon(
                  Icons.psychology_alt,
                  size: 24,
                ),
              ),
              SizedBox(width: 11),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      'Agent Duke Da Boss X',
                      style: TextStyle(
                        fontWeight: FontWeight.w900,
                        fontSize: 17,
                      ),
                    ),
                    Text(
                      '999 Trading Intelligence AI Analyst',
                      style: TextStyle(
                        color: Colors.white60,
                        fontSize: 11,
                      ),
                    ),
                  ],
                ),
              ),
              Icon(
                Icons.circle,
                size: 10,
                color: Colors.greenAccent,
              ),
            ],
          ),
          const SizedBox(height: 15),
          Text(
            headline,
            style: const TextStyle(
              fontWeight: FontWeight.w900,
              fontSize: 15,
            ),
          ),
          const SizedBox(height: 7),
          Text(
            detail,
            style: const TextStyle(
              height: 1.45,
              fontSize: 13,
            ),
          ),
          if (top != null) ...[
            const SizedBox(height: 14),
            Row(
              children: [
                Expanded(
                  child: _agentMetric(
                    'TOP ASSET',
                    top.symbol,
                  ),
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: _agentMetric(
                    'CONFIDENCE',
                    '${top.score}/100',
                  ),
                ),
              ],
            ),
            const SizedBox(height: 8),
            Row(
              children: [
                Expanded(
                  child: _agentMetric(
                    'QUALITY',
                    _setupQuality(top),
                  ),
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: _agentMetric(
                    'RSI',
                    top.rsi14.toStringAsFixed(1),
                  ),
                ),
              ],
            ),
          ],
        ],
