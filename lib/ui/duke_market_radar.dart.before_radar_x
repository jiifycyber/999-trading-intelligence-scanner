import 'dart:math';

import 'package:flutter/material.dart';

import '../models/scan_result.dart';

class DukeMarketRadar extends StatelessWidget {
  final List<ScanResult> results;

  const DukeMarketRadar({
    super.key,
    required this.results,
  });

  int _score(ScanResult result) {
    num raw = 0;

    try {
      final value = (result as dynamic).score;
      if (value is num) raw = value;
    } catch (_) {
      try {
        final value = (result as dynamic).confidence;
        if (value is num) raw = value;
      } catch (_) {}
    }

    if (raw > 0 && raw <= 1) raw *= 100;
    return raw.clamp(0, 100).round();
  }

  String _rawSignal(ScanResult result) {
    try {
      return '${(result as dynamic).signal}'.toUpperCase();
    } catch (_) {
      return 'WAIT';
    }
  }

  String _direction(ScanResult result) {
    final raw = _rawSignal(result);

    if (_score(result) < 80) return 'WAIT';

    if (raw.contains('CALL') || raw.contains('BUY') || raw.contains('UP')) {
      return 'CALL';
    }

    if (raw.contains('PUT') || raw.contains('SELL') || raw.contains('DOWN')) {
      return 'PUT';
    }

    return 'WAIT';
  }

  String _quality(int score) {
    if (score >= 90) return 'ELITE';
    if (score >= 80) return 'STRONG';
    if (score >= 70) return 'GOOD';
    return 'WEAK';
  }

  String _reason(ScanResult result) {
    try {
      final value = (result as dynamic).reasons;

      if (value is Iterable) {
        final reasons = value
            .map((item) => '$item')
            .where((item) => item.trim().isNotEmpty)
            .take(2)
            .toList();

        if (reasons.isNotEmpty) {
          return reasons.join(' • ');
        }
      }
    } catch (_) {}

    try {
      final value = '${(result as dynamic).reason}';
      if (value.trim().isNotEmpty) return value;
    } catch (_) {}

    try {
      final value = '${(result as dynamic).trend}';
      if (value.trim().isNotEmpty) return 'Trend: $value';
    } catch (_) {}

    return 'Waiting for additional live confirmation';
  }

  bool _isLocked(ScanResult result) {
    return _rawSignal(result).contains('LOCK');
  }

  Color _signalColor(String signal) {
    if (signal == 'CALL') return const Color(0xFF1EF2A4);
    if (signal == 'PUT') return const Color(0xFFFF4D68);
    return const Color(0xFFFFC857);
  }

  String _price(ScanResult result) {
    if (result.price.abs() >= 1000) {
      return result.price.toStringAsFixed(2);
    }
    return result.price.toStringAsFixed(5);
  }

  Widget _statusChip(
    String label, {
    required bool active,
    required Color color,
  }) {
    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: 12,
        vertical: 7,
      ),
      decoration: BoxDecoration(
        color: active ? color.withAlpha(45) : const Color(0xFF181526),
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: active ? color : const Color(0xFF39334C),
        ),
      ),
      child: Text(
        label,
        style: TextStyle(
          color: active ? color : const Color(0xFF8F88A3),
          fontSize: 11,
          fontWeight: FontWeight.w800,
          letterSpacing: 0.8,
        ),
      ),
    );
  }

  Widget _targetCard(
    ScanResult result,
    int rank,
  ) {
    final score = _score(result);
    final signal = _direction(result);
    final color = _signalColor(signal);

    return Container(
      width: 210,
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: const Color(0xFF14111F),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: rank == 1 ? color.withAlpha(150) : const Color(0xFF322B47),
        ),
      ),
      child: Row(
        children: [
          Container(
            width: 30,
            height: 30,
            alignment: Alignment.center,
            decoration: BoxDecoration(
              color: color.withAlpha(35),
              shape: BoxShape.circle,
            ),
            child: Text(
              '$rank',
              style: TextStyle(
                color: color,
                fontWeight: FontWeight.w900,
              ),
            ),
          ),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  result.symbol,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.w800,
                  ),
                ),
                const SizedBox(height: 3),
                Text(
                  '$score/100 • ${_quality(score)}',
                  style: const TextStyle(
                    color: Color(0xFF9E96B4),
                    fontSize: 11,
                  ),
                ),
              ],
            ),
          ),
          Text(
            signal,
            style: TextStyle(
              color: color,
              fontWeight: FontWeight.w900,
              fontSize: 12,
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final ranked = [...results]..sort(
        (a, b) => _score(b).compareTo(_score(a)),
      );

    final top = ranked.isEmpty ? null : ranked.first;

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: const Color(0xFF0E0B17),
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: const Color(0xFF6638D8),
        ),
        boxShadow: const [
          BoxShadow(
            color: Color(0x336A35FF),
            blurRadius: 24,
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Row(
            children: [
              Icon(
                Icons.radar,
                color: Color(0xFF9B66FF),
              ),
              SizedBox(width: 9),
              Expanded(
                child: Text(
                  'DUKE MARKET RADAR',
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: 16,
                    fontWeight: FontWeight.w900,
                    letterSpacing: 1,
                  ),
                ),
              ),
              Text(
                'LIVE RANKING',
                style: TextStyle(
                  color: Color(0xFF1EF2A4),
                  fontSize: 10,
                  fontWeight: FontWeight.w900,
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          if (top == null)
            const Expanded(
              child: Center(
                child: Text(
                  'Waiting for live market data…',
                  style: TextStyle(
                    color: Color(0xFF9E96B4),
                  ),
                ),
              ),
            )
          else ...[
            Builder(
              builder: (context) {
                final score = _score(top);
                final signal = _direction(top);
                final color = _signalColor(signal);
                final locked = _isLocked(top);

                return Container(
                  padding: const EdgeInsets.all(14),
                  decoration: BoxDecoration(
                    color: color.withAlpha(18),
                    borderRadius: BorderRadius.circular(16),
                    border: Border.all(
                      color: color.withAlpha(120),
                    ),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  top.symbol,
                                  style: const TextStyle(
                                    color: Colors.white,
                                    fontSize: 20,
                                    fontWeight: FontWeight.w900,
                                  ),
                                ),
                                Text(
                                  _price(top),
                                  style: const TextStyle(
                                    color: Color(0xFFAAA2BC),
                                  ),
                                ),
                              ],
                            ),
                          ),
                          Column(
                            crossAxisAlignment: CrossAxisAlignment.end,
                            children: [
                              Text(
                                signal,
                                style: TextStyle(
                                  color: color,
                                  fontSize: 26,
                                  fontWeight: FontWeight.w900,
                                ),
                              ),
                              Text(
                                '$score/100 • ${_quality(score)}',
                                style: const TextStyle(
                                  color: Color(0xFFB9B1CB),
                                  fontWeight: FontWeight.w700,
                                ),
                              ),
                            ],
                          ),
                        ],
                      ),
                      const SizedBox(height: 8),
                      Text(
                        _reason(top),
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          color: Color(0xFFC4BDD2),
                          fontSize: 12,
                        ),
                      ),
                      const SizedBox(height: 10),
                      Wrap(
                        spacing: 7,
                        runSpacing: 7,
                        children: [
                          _statusChip(
                            'CALL',
                            active: signal == 'CALL',
                            color: const Color(0xFF1EF2A4),
                          ),
                          _statusChip(
                            'PUT',
                            active: signal == 'PUT',
                            color: const Color(0xFFFF4D68),
                          ),
                          _statusChip(
                            'WAIT',
                            active: signal == 'WAIT',
                            color: const Color(0xFFFFC857),
                          ),
                          _statusChip(
                            'LOCKED',
                            active: locked,
                            color: const Color(0xFF9B66FF),
                          ),
                        ],
                      ),
                    ],
                  ),
                );
              },
            ),
            const SizedBox(height: 10),
            SizedBox(
              height: 66,
              child: ListView.separated(
                scrollDirection: Axis.horizontal,
                itemCount: min(3, ranked.length),
                separatorBuilder: (_, __) => const SizedBox(width: 8),
                itemBuilder: (context, index) =>
                    _targetCard(ranked[index], index + 1),
              ),
            ),
            const SizedBox(height: 7),
            const Text(
              'Three confirmations required for a 60-second lock. Confirm the setup on your broker chart.',
              style: TextStyle(
                color: Color(0xFF777087),
                fontSize: 10,
              ),
            ),
          ],
        ],
      ),
    );
  }
}
