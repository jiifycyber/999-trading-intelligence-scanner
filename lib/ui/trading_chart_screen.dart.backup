import 'dart:math';

import 'package:flutter/material.dart';

import '../core/scanner_engine.dart';
import '../models/scan_result.dart';

class TradingChartScreen extends StatefulWidget {
  final ScannerEngine engine;

  const TradingChartScreen({
    super.key,
    required this.engine,
  });

  @override
  State<TradingChartScreen> createState() => _TradingChartScreenState();
}

class _TradingChartScreenState extends State<TradingChartScreen> {
  String timeframe = '1M';
  String? selectedSymbol;

  bool showEma9 = true;
  bool showEma21 = true;
  bool showBollinger = true;

  final List<_Candle> candles = [];

  int get bucketSeconds {
    switch (timeframe) {
      case '5M':
        return 300;
      case '15M':
        return 900;
      default:
        return 60;
    }
  }

  @override
  void initState() {
    super.initState();
    widget.engine.addListener(_engineChanged);
    _engineChanged();
  }

  @override
  void dispose() {
    widget.engine.removeListener(_engineChanged);
    super.dispose();
  }

  ScanResult? _currentResult() {
    final results = widget.engine.rankedResults;

    if (results.isEmpty) return null;

    selectedSymbol ??= results.first.symbol;

    for (final result in results) {
      if (result.symbol == selectedSymbol) {
        return result;
      }
    }

    selectedSymbol = results.first.symbol;
    return results.first;
  }

  void _engineChanged() {
    final result = _currentResult();
    if (result == null) {
      if (mounted) setState(() {});
      return;
    }

    final now = DateTime.now().millisecondsSinceEpoch;
    final bucketMs = bucketSeconds * 1000;
    final bucketStart = (now ~/ bucketMs) * bucketMs;

    if (candles.isEmpty || candles.last.time != bucketStart) {
      candles.add(
        _Candle(
          time: bucketStart,
          open: result.price,
          high: result.price,
          low: result.price,
          close: result.price,
        ),
      );
    } else {
      final c = candles.last;
      candles[candles.length - 1] = _Candle(
        time: c.time,
        open: c.open,
        high: max(c.high, result.price),
        low: min(c.low, result.price),
        close: result.price,
      );
    }

    if (candles.length > 240) {
      candles.removeAt(0);
    }

    if (mounted) setState(() {});
  }

  void _changeTimeframe(String value) {
    setState(() {
      timeframe = value;
      candles.clear();
    });

    switch (value) {
      case '5M':
        widget.engine.setTimeframeSeconds(300);
        break;
      case '15M':
        widget.engine.setTimeframeSeconds(900);
        break;
      default:
        widget.engine.setTimeframeSeconds(60);
    }

    _engineChanged();
  }

  List<double> _ema(List<double> values, int period) {
    if (values.isEmpty) return [];

    final output = <double>[];
    final k = 2 / (period + 1);
    double ema = values.first;

    for (final value in values) {
      ema = value * k + ema * (1 - k);
      output.add(ema);
    }

    return output;
  }

  @override
  Widget build(BuildContext context) {
    final results = widget.engine.rankedResults;
    final current = _currentResult();

    final closes = candles.map((c) => c.close).toList();
    final ema9 = _ema(closes, 9);
    final ema21 = _ema(closes, 21);

    return Container(
      color: const Color(0xFF080B16),
      child: Column(
        children: [
          _toolbar(results, current),
          Expanded(
            child: Padding(
              padding: const EdgeInsets.fromLTRB(14, 8, 14, 14),
              child: Container(
                decoration: BoxDecoration(
                  color: const Color(0xFF0C1020),
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(
                    color: Colors.white.withValues(alpha: .10),
                  ),
                ),
                child: candles.isEmpty
                    ? const Center(
                        child: Text(
                          'Waiting for market prices...',
                          style: TextStyle(color: Colors.white54),
                        ),
                      )
                    : Column(
                        children: [
                          _priceHeader(current),
                          Expanded(
                            child: ClipRRect(
                              borderRadius: BorderRadius.circular(10),
                              child: CustomPaint(
                                painter: _TradingChartPainter(
                                  candles: candles,
                                  ema9: ema9,
                                  ema21: ema21,
                                  showEma9: showEma9,
                                  showEma21: showEma21,
                                  showBollinger: showBollinger,
                                ),
                                child: const SizedBox.expand(),
                              ),
                            ),
                          ),
                        ],
                      ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _toolbar(
    List<ScanResult> results,
    ScanResult? current,
  ) {
    return Container(
      height: 66,
      padding: const EdgeInsets.symmetric(horizontal: 16),
      decoration: const BoxDecoration(
        color: Color(0xFF0B0E1A),
        border: Border(
          bottom: BorderSide(color: Colors.white12),
        ),
      ),
      child: Row(
        children: [
          const Icon(Icons.candlestick_chart, color: Color(0xFF9B6CFF)),
          const SizedBox(width: 10),
          const Text(
            'ADVANCED CHART',
            style: TextStyle(
              fontWeight: FontWeight.w900,
              letterSpacing: .8,
            ),
          ),
          const SizedBox(width: 20),
          if (results.isNotEmpty)
            DropdownButton<String>(
              value: selectedSymbol,
              dropdownColor: const Color(0xFF171B2C),
              underline: const SizedBox(),
              items: results
                  .map(
                    (r) => DropdownMenuItem(
                      value: r.symbol,
                      child: Text(r.symbol),
                    ),
                  )
                  .toList(),
              onChanged: (value) {
                if (value == null) return;

                setState(() {
                  selectedSymbol = value;
                  candles.clear();
                });

                _engineChanged();
              },
            ),
          const SizedBox(width: 20),
          _timeButton('1M'),
          const SizedBox(width: 6),
          _timeButton('5M'),
          const SizedBox(width: 6),
          _timeButton('15M'),
          const Spacer(),
          _indicatorButton(
            'EMA 9',
            showEma9,
            () => setState(() => showEma9 = !showEma9),
          ),
          const SizedBox(width: 6),
          _indicatorButton(
            'EMA 21',
            showEma21,
            () => setState(() => showEma21 = !showEma21),
          ),
          const SizedBox(width: 6),
          _indicatorButton(
            'BOLL',
            showBollinger,
            () => setState(() => showBollinger = !showBollinger),
          ),
        ],
      ),
    );
  }

  Widget _timeButton(String value) {
    final active = timeframe == value;

    return FilledButton(
      onPressed: () => _changeTimeframe(value),
      style: FilledButton.styleFrom(
        backgroundColor:
            active ? const Color(0xFF6D35E8) : const Color(0xFF171B2C),
        padding: const EdgeInsets.symmetric(
          horizontal: 13,
          vertical: 10,
        ),
      ),
      child: Text(value),
    );
  }

  Widget _indicatorButton(
    String text,
    bool active,
    VoidCallback onPressed,
  ) {
    return OutlinedButton(
      onPressed: onPressed,
      style: OutlinedButton.styleFrom(
        foregroundColor: active ? const Color(0xFFB99AFF) : Colors.white54,
      ),
      child: Text(text),
    );
  }

  Widget _priceHeader(ScanResult? result) {
    if (result == null) return const SizedBox();

    return Container(
      height: 64,
      padding: const EdgeInsets.symmetric(horizontal: 18),
      child: Row(
        children: [
          Text(
            result.symbol,
            style: const TextStyle(
              fontSize: 18,
              fontWeight: FontWeight.w900,
            ),
          ),
          const SizedBox(width: 14),
          Text(
            result.price.toStringAsFixed(5),
            style: const TextStyle(
              fontSize: 17,
              fontWeight: FontWeight.w800,
              color: Color(0xFF71E6A8),
            ),
          ),
          const SizedBox(width: 18),
          Text(
            result.side.name.toUpperCase(),
            style: TextStyle(
              fontWeight: FontWeight.w900,
              color: result.side == SignalSide.call
                  ? const Color(0xFF71E6A8)
                  : result.side == SignalSide.put
                      ? const Color(0xFFFF6B78)
                      : Colors.white54,
            ),
          ),
          const SizedBox(width: 12),
          Text(
            '${result.score}/100',
            style: const TextStyle(color: Colors.white70),
          ),
          const Spacer(),
          Text(
            '$timeframe • LIVE',
            style: const TextStyle(
              color: Colors.white54,
              fontWeight: FontWeight.w700,
            ),
          ),
        ],
      ),
    );
  }
}

class _Candle {
  final int time;
  final double open;
  final double high;
  final double low;
  final double close;

  const _Candle({
    required this.time,
    required this.open,
    required this.high,
    required this.low,
    required this.close,
  });
}

class _TradingChartPainter extends CustomPainter {
  final List<_Candle> candles;
  final List<double> ema9;
  final List<double> ema21;
  final bool showEma9;
  final bool showEma21;
  final bool showBollinger;

  _TradingChartPainter({
    required this.candles,
    required this.ema9,
    required this.ema21,
    required this.showEma9,
    required this.showEma21,
    required this.showBollinger,
  });

  @override
  void paint(Canvas canvas, Size size) {
    if (candles.isEmpty) return;

    final highs = candles.map((c) => c.high);
    final lows = candles.map((c) => c.low);

    double maxPrice = highs.reduce(max);
    double minPrice = lows.reduce(min);

    if (maxPrice == minPrice) {
      maxPrice += .0001;
      minPrice -= .0001;
    }

    final padding = (maxPrice - minPrice) * .08;
    maxPrice += padding;
    minPrice -= padding;

    final gridPaint = Paint()
      ..color = Colors.white.withValues(alpha: .06)
      ..strokeWidth = 1;

    for (int i = 0; i <= 6; i++) {
      final y = size.height * i / 6;
      canvas.drawLine(
        Offset(0, y),
        Offset(size.width, y),
        gridPaint,
      );
    }

    for (int i = 0; i <= 10; i++) {
      final x = size.width * i / 10;
      canvas.drawLine(
        Offset(x, 0),
        Offset(x, size.height),
        gridPaint,
      );
    }

    double yFor(double price) {
      return size.height -
          ((price - minPrice) / (maxPrice - minPrice)) * size.height;
    }

    final visible = min(candles.length, 90);
    final start = candles.length - visible;
    final width = size.width / max(visible, 1);
    final bodyWidth = max(2.0, width * .55);

    for (int i = start; i < candles.length; i++) {
      final candle = candles[i];
      final screenIndex = i - start;
      final x = width * screenIndex + width / 2;

      final up = candle.close >= candle.open;

      final paint = Paint()
        ..color = up ? const Color(0xFF38D996) : const Color(0xFFFF5364)
        ..strokeWidth = 1.2;

      canvas.drawLine(
        Offset(x, yFor(candle.high)),
        Offset(x, yFor(candle.low)),
        paint,
      );

      final top = yFor(max(candle.open, candle.close));
      final bottom = yFor(min(candle.open, candle.close));

      canvas.drawRect(
        Rect.fromLTRB(
          x - bodyWidth / 2,
          top,
          x + bodyWidth / 2,
          max(bottom, top + 1.5),
        ),
        paint,
      );
    }

    if (showEma9) {
      _drawLine(
        canvas,
        size,
        ema9,
        start,
        visible,
        minPrice,
        maxPrice,
        const Color(0xFFFFC857),
      );
    }

    if (showEma21) {
      _drawLine(
        canvas,
        size,
        ema21,
        start,
        visible,
        minPrice,
        maxPrice,
        const Color(0xFFB47CFF),
      );
    }

    if (showBollinger && candles.length >= 20) {
      final closes = candles.map((c) => c.close).toList();
      final upper = <double>[];
      final lower = <double>[];

      for (int i = 0; i < closes.length; i++) {
        final from = max(0, i - 19);
        final window = closes.sublist(from, i + 1);
        final avg = window.reduce((a, b) => a + b) / window.length;

        final variance = window
                .map((v) => pow(v - avg, 2).toDouble())
                .reduce((a, b) => a + b) /
            window.length;

        final sd = sqrt(variance);

        upper.add(avg + 2 * sd);
        lower.add(avg - 2 * sd);
      }

      _drawLine(
        canvas,
        size,
        upper,
        start,
        visible,
        minPrice,
        maxPrice,
        const Color(0xFF2A9D8F),
      );

      _drawLine(
        canvas,
        size,
        lower,
        start,
        visible,
        minPrice,
        maxPrice,
        const Color(0xFF2A9D8F),
      );
    }
  }

  void _drawLine(
    Canvas canvas,
    Size size,
    List<double> values,
    int start,
    int visible,
    double minPrice,
    double maxPrice,
    Color color,
  ) {
    if (values.length <= start) return;

    final path = Path();
    final width = size.width / max(visible, 1);

    bool started = false;

    for (int i = start; i < values.length; i++) {
      final x = width * (i - start) + width / 2;
      final y = size.height -
          ((values[i] - minPrice) / (maxPrice - minPrice)) * size.height;

      if (!started) {
        path.moveTo(x, y);
        started = true;
      } else {
        path.lineTo(x, y);
      }
    }

    canvas.drawPath(
      path,
      Paint()
        ..color = color
        ..strokeWidth = 1.5
        ..style = PaintingStyle.stroke,
    );
  }

  @override
  bool shouldRepaint(covariant _TradingChartPainter oldDelegate) {
    return true;
  }
}
