class TradingChartScreen extends StatefulWidget {
  final ScannerEngine engine;

  const TradingChartScreen({
    super.key,
    required this.engine,
  });

  @override
  State<TradingChartScreen> createState() => _TradingChartScreenState();
}

class _TradingChartScreenState extends State<TradingChartScreen> {
  String? _loadedHistorySymbol;

  String timeframe = '1M';
  String? selectedSymbol;

  final Set<String> favoriteSymbols = {};

  bool showEma9 = true;
  bool showEma21 = true;
  bool showBollinger = true;

  final List<_ChartCandle> candles = [];

  double visibleBars = 60;
  double historyOffset = 0;

  double priceScale = 1.0;
  double priceOffsetPixels = 0;

  Offset? crosshair;

  Offset scaleStartPoint = Offset.zero;
  double scaleStartVisibleBars = 60;
  double scaleStartHistoryOffset = 0;
  double scaleStartPriceOffset = 0;
  double scaleStartPriceScale = 1;

  int get timeframeSeconds {
    switch (timeframe) {
      case '5M':
        return 300;
      case '15M':
        return 900;
      default:
        return 60;
    }
  }

  @override
  void initState() {
    super.initState();

    widget.engine.addListener(_engineChanged);

    WidgetsBinding.instance.addPostFrameCallback((_) {
      _engineChanged();
    });
  }

  @override
  void dispose() {
    widget.engine.removeListener(_engineChanged);
    super.dispose();
  }

  ScanResult? get currentResult {
    final results = widget.engine.rankedResults;

    if (results.isEmpty) return null;

    selectedSymbol ??= results.first.symbol;

    for (final result in results) {
      if (result.symbol == selectedSymbol) {
        return result;
      }
    }

    // Manual chart selection stays locked.
    // Do not replace selectedSymbol with the scanner's top-ranked asset.
    return results.first;
  }

  void _engineChanged() {
    final result = currentResult;

    if (result == null) {
      if (mounted) setState(() {});
      return;
    }

    final now = DateTime.now().millisecondsSinceEpoch;
    final bucketMs = timeframeSeconds * 1000;

    final bucket = (now ~/ bucketMs) * bucketMs;

    if (candles.isEmpty || candles.last.time != bucket) {
      candles.add(
        _ChartCandle(
          time: bucket,
          open: result.price,
          high: result.price,
          low: result.price,
          close: result.price,
        ),
      );
    } else {
      final old = candles.last;

      candles[candles.length - 1] = _ChartCandle(
        time: old.time,
        open: old.open,
        high: max(old.high, result.price),
        low: min(old.low, result.price),
        close: result.price,
      );
    }

    if (candles.length > 2000) {
      candles.removeAt(0);
    }

    if (mounted) {
      setState(() {});
    }
  }

  void _selectTimeframe(String value) {
    setState(() {
      timeframe = value;

      candles.clear();

      visibleBars = value == '1M'
          ? 60
          : value == '5M'
              ? 48
              : 40;

      historyOffset = 0;
      priceScale = 1;
      priceOffsetPixels = 0;
      crosshair = null;
    });

    if (value == '5M') {
      widget.engine.setTimeframeSeconds(300);
    } else if (value == '15M') {
      widget.engine.setTimeframeSeconds(900);
    } else {
      widget.engine.setTimeframeSeconds(60);
    }

    _engineChanged();
  }

  void _resetChart() {
    setState(() {
      visibleBars = 60;
      historyOffset = 0;
      priceScale = 1;
      priceOffsetPixels = 0;
      crosshair = null;
    });
  }

  void _limitHistoryOffset() {
    final available = candles.length.toDouble();

    final maxOffset = max(
      0.0,
      available - min(visibleBars, available),
    );

    historyOffset = historyOffset.clamp(0.0, maxOffset).toDouble();
  }

  void _mouseWheel(PointerSignalEvent event) {
    if (event is! PointerScrollEvent) return;

    setState(() {
      if (event.scrollDelta.dy.abs() > event.scrollDelta.dx.abs()) {
        final factor = event.scrollDelta.dy > 0 ? 1.12 : .88;

        visibleBars = (visibleBars * factor).clamp(8.0, 400.0).toDouble();
      } else {
        historyOffset += event.scrollDelta.dx / 15;

        _limitHistoryOffset();
      }
    });
  }

  void _scaleStart(ScaleStartDetails details) {
    scaleStartPoint = details.localFocalPoint;

    scaleStartVisibleBars = visibleBars;

    scaleStartHistoryOffset = historyOffset;

    scaleStartPriceOffset = priceOffsetPixels;

    scaleStartPriceScale = priceScale;
  }

  void _scaleUpdate(ScaleUpdateDetails details) {
    final box = context.findRenderObject();

    double width = 900;

    if (box is RenderBox) {
      width = box.size.width;
    }

    final dx = details.localFocalPoint.dx - scaleStartPoint.dx;

    final dy = details.localFocalPoint.dy - scaleStartPoint.dy;

    setState(() {
      // Pinch zoom.
      if ((details.scale - 1).abs() > .002) {
        visibleBars = (scaleStartVisibleBars / details.scale)
            .clamp(8.0, 400.0)
            .toDouble();

        priceScale =
            (scaleStartPriceScale * details.scale).clamp(.30, 8.0).toDouble();
      }

      // Same scale recognizer handles drag.
      // This avoids Flutter's pan + scale
      // GestureDetector conflict.
      final barsPerPixel = visibleBars / max(width, 1.0);

      historyOffset = scaleStartHistoryOffset + (-dx * barsPerPixel);

      priceOffsetPixels = scaleStartPriceOffset + dy;

      crosshair = details.localFocalPoint;

      _limitHistoryOffset();
    });
  }

  @override
  Widget build(BuildContext context) {
    final results = widget.engine.rankedResults;

    final result = currentResult;

    return Material(
      color: const Color(0xFF06090F),
      child: Column(
        children: [
          _topToolbar(results),
          if (result != null) _marketHeader(result),
          Expanded(
            child: result == null
                ? const Center(
                    child: Text(
                      'WAITING FOR MARKET DATA...',
                      style: TextStyle(
                        color: Colors.white54,
                        fontWeight: FontWeight.w800,
                      ),
                    ),
                  )
                : _chartBody(),
          ),
          _bottomBar(),
        ],
      ),
    );
  }

  Future<void> _openMarketPicker() async {
    final picked = await showDialog<String>(
      context: context,
      builder: (dialogContext) {
        return _MarketPickerDialog(
          selectedSymbol: selectedSymbol,
          favorites: favoriteSymbols,
        );
      },
    );

    if (picked == null || picked == selectedSymbol) return;

    setState(() {
      selectedSymbol = picked;

      // Never mix candles from different markets.
      candles.clear();

      historyOffset = 0;
      priceScale = 1;
      priceOffsetPixels = 0;
      crosshair = null;
    });

    _engineChanged();

    // Restore this market's saved 1-minute candles.
  }

