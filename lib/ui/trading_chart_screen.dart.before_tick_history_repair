  }

  Widget _timeButton(String value) {
    final active = timeframe == value;

    return FilledButton(
      onPressed: () => _selectTimeframe(value),
      style: FilledButton.styleFrom(
        backgroundColor:
            active ? const Color(0xFF6B35E8) : const Color(0xFF171C28),
        foregroundColor: Colors.white,
        padding: const EdgeInsets.symmetric(
          horizontal: 13,
          vertical: 9,
        ),
      ),
      child: Text(value),
    );
  }

  Widget _indicatorButton(
    String label,
    bool enabled,
    VoidCallback callback,
  ) {
    return OutlinedButton(
      onPressed: callback,
      style: OutlinedButton.styleFrom(
        foregroundColor: enabled ? const Color(0xFFC1A8FF) : Colors.white38,
        side: BorderSide(
          color: enabled ? const Color(0xFF7953CE) : const Color(0xFF303646),
        ),
      ),
      child: Text(label),
    );
  }

