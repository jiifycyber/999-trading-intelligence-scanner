            showEma21,
            () {
              setState(() {
                showEma21 = !showEma21;
              });
            },
          ),
          _indicatorButton(
            'BB',
            showBollinger,
            () {
              setState(() {
                showBollinger = !showBollinger;
              });
            },
          ),
          IconButton(
            tooltip: 'Auto fit',
            onPressed: _resetChart,
            icon: const Icon(
              Icons.fit_screen,
