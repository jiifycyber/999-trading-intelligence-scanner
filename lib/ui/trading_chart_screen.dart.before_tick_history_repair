            color: Color(0xFF202736),
          ),
        ),
      ),
      child: Wrap(
        spacing: 7,
        runSpacing: 7,
        crossAxisAlignment: WrapCrossAlignment.center,
        children: [
          const Icon(
            Icons.candlestick_chart,
            color: Color(0xFF9D6CFF),
          ),
          const Text(
            'ADVANCED CHART',
            style: TextStyle(
              color: Colors.white,
              fontWeight: FontWeight.w900,
            ),
          ),
          if (results.isNotEmpty || MarketCatalog.all.isNotEmpty)
            OutlinedButton.icon(
              onPressed: _openMarketPicker,
              icon: const Icon(Icons.search, size: 17),
              label: Text(
                selectedSymbol ?? 'SELECT MARKET',
                style: const TextStyle(
