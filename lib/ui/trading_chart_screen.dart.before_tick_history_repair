                ),
              ),
            ),
          _timeButton('1M'),
          _timeButton('5M'),
          _timeButton('15M'),
          _indicatorButton(
            'EMA 9',
            showEma9,
            () {
              setState(() {
                showEma9 = !showEma9;
              });
            },
          ),
          _indicatorButton(
