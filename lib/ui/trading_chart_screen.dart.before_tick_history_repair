class _ChartCandle {
  final int time;
  final double open;
  final double high;
  final double low;
  final double close;

  const _ChartCandle({
    required this.time,
    required this.open,
    required this.high,
    required this.low,
    required this.close,
  });
}

class _TradeChartPainter extends CustomPainter {
  final List<_ChartCandle> candles;

  final double visibleBars;
  final double historyOffset;

  final double priceScale;
  final double priceOffsetPixels;

  final Offset? crosshair;

  final bool showEma9;
  final bool showEma21;
  final bool showBollinger;

  _TradeChartPainter({
    required this.candles,
    required this.visibleBars,
    required this.historyOffset,
    required this.priceScale,
    required this.priceOffsetPixels,
    required this.crosshair,
    required this.showEma9,
    required this.showEma21,
    required this.showBollinger,
  });

  @override
  void paint(
    Canvas canvas,
    Size size,
  ) {
    canvas.drawRect(
      Offset.zero & size,
      Paint()..color = const Color(0xFF060A11),
    );

    if (candles.isEmpty) return;

    const priceAxis = 80.0;
    const timeAxis = 30.0;

    final chartWidth = max(
      1.0,
      size.width - priceAxis,
    ).toDouble();

    final chartHeight = max(
      1.0,
      size.height - timeAxis,
    ).toDouble();

    final available = candles.length;

    final requested = visibleBars.round().clamp(
          1,
          max(1, available),
        );

    final end = (available - historyOffset.round())
        .clamp(
          1,
          available,
        )
        .toInt();

    final start = max(
      0,
      end - requested,
    ).toInt();

    final visible = candles.sublist(
      start,
      end,
    );

    if (visible.isEmpty) return;

    double low = visible.first.low;

    double high = visible.first.high;

    for (final c in visible) {
      low = min(low, c.low);
      high = max(high, c.high);
    }

    if ((high - low).abs() < .00000001) {
      final expand = max(
        high.abs() * .001,
        .0001,
      ).toDouble();

      high += expand;
      low -= expand;
    }

    final rawRange = high - low;

    final baseCenter = (high + low) / 2;

    final shiftedCenter =
        baseCenter + ((priceOffsetPixels / chartHeight) * rawRange);

    final displayRange = rawRange / max(priceScale, .05);

    final paddedRange = displayRange * 1.16;

    final displayMin = shiftedCenter - paddedRange / 2;

    final displayMax = shiftedCenter + paddedRange / 2;

    final range = displayMax - displayMin;

    double yFor(double price) {
      return chartHeight - ((price - displayMin) / range) * chartHeight;
    }

    final slot = chartWidth / max(visible.length, 1);

    double xFor(int index) {
      return slot * index + slot / 2;
    }

    final chartRect = Rect.fromLTWH(
      0,
      0,
      chartWidth,
      chartHeight,
    );

    canvas.save();
    canvas.clipRect(chartRect);

    _grid(
      canvas,
      chartWidth,
      chartHeight,
    );

    if (showBollinger) {
      _bollinger(
        canvas,
        visible,
        xFor,
        yFor,
      );
    }

    if (showEma21) {
      _ema(
        canvas,
        visible,
        21,
        xFor,
        yFor,
        const Color(0xFFFF9F43),
      );
    }

    if (showEma9) {
      _ema(
        canvas,
        visible,
        9,
        xFor,
        yFor,
        const Color(0xFF7B61FF),
      );
    }

    final bodyWidth = (slot * .68)
        .clamp(
          2.0,
          16.0,
        )
        .toDouble();

    for (int i = 0; i < visible.length; i++) {
      final c = visible[i];

      final rising = c.close >= c.open;

      final color = rising ? const Color(0xFF4DB69B) : const Color(0xFFE64B50);

      final x = xFor(i);

      final openY = yFor(c.open);

      final closeY = yFor(c.close);

      final highY = yFor(c.high);

      final lowY = yFor(c.low);

      final paint = Paint()
        ..color = color
        ..strokeWidth = 1.3;

      canvas.drawLine(
        Offset(x, highY),
        Offset(x, lowY),
        paint,
      );

      final top = min(openY, closeY);

      final bottom = max(openY, closeY);

      canvas.drawRect(
        Rect.fromLTRB(
          x - bodyWidth / 2,
          top,
          x + bodyWidth / 2,
          max(
            top + 1.5,
            bottom,
          ),
        ),
        paint,
      );
    }

    final currentPrice = visible.last.close;

    final currentY = yFor(currentPrice);

    if (currentY >= 0 && currentY <= chartHeight) {
      final pricePaint = Paint()
        ..color = const Color(0xFF4DB69B)
        ..strokeWidth = 1;

      for (double x = 0; x < chartWidth; x += 10) {
        canvas.drawLine(
          Offset(x, currentY),
          Offset(
            min(
              x + 5,
              chartWidth,
            ).toDouble(),
            currentY,
          ),
          pricePaint,
        );
      }
    }

    if (crosshair != null &&
        chartRect.contains(
          crosshair!,
        )) {
      final paint = Paint()
        ..color = Colors.white.withValues(
          alpha: .40,
        )
        ..strokeWidth = .8;

      canvas.drawLine(
        Offset(
          crosshair!.dx,
          0,
        ),
        Offset(
          crosshair!.dx,
          chartHeight,
        ),
        paint,
      );

      canvas.drawLine(
        Offset(
          0,
          crosshair!.dy,
        ),
        Offset(
          chartWidth,
          crosshair!.dy,
        ),
        paint,
      );
    }

    canvas.restore();

    _priceAxis(
      canvas,
      chartWidth,
      chartHeight,
      displayMin,
      displayMax,
      currentPrice,
      currentY,
    );

    _timeAxis(
      canvas,
      chartWidth,
      chartHeight,
      visible,
      slot,
    );
  }

  void _grid(
    Canvas canvas,
    double width,
    double height,
  ) {
    final paint = Paint()
      ..color = Colors.white.withValues(
        alpha: .06,
      )
      ..strokeWidth = 1;

    for (int i = 0; i <= 7; i++) {
      final y = height * i / 7;

      canvas.drawLine(
        Offset(0, y),
        Offset(width, y),
        paint,
      );
    }

    for (int i = 0; i <= 10; i++) {
      final x = width * i / 10;

      canvas.drawLine(
        Offset(x, 0),
        Offset(x, height),
        paint,
      );
    }
  }

  void _ema(
    Canvas canvas,
    List<_ChartCandle> data,
    int period,
    double Function(int) xFor,
    double Function(double) yFor,
    Color color,
  ) {
    if (data.length < 2) return;

    final closes = data.map((c) => c.close).toList();

    final k = 2 / (period + 1);

    double ema = closes.first;

    final values = <double>[];

    for (final close in closes) {
      ema = close * k + ema * (1 - k);

      values.add(ema);
    }

    final path = Path();

    for (int i = 0; i < values.length; i++) {
      final x = xFor(i);
      final y = yFor(values[i]);

      if (i == 0) {
        path.moveTo(x, y);
      } else {
        path.lineTo(x, y);
      }
    }

    canvas.drawPath(
      path,
      Paint()
        ..color = color
        ..strokeWidth = 1.5
        ..style = PaintingStyle.stroke,
    );
  }

  void _bollinger(
    Canvas canvas,
    List<_ChartCandle> data,
    double Function(int) xFor,
    double Function(double) yFor,
  ) {
    if (data.length < 2) return;

    final closes = data.map((c) => c.close).toList();

    final upper = <double>[];
    final lower = <double>[];

    for (int i = 0; i < closes.length; i++) {
      final start = max(0, i - 19);

      final sample = closes.sublist(
        start,
        i + 1,
      );

      final mean = sample.reduce(
            (a, b) => a + b,
          ) /
          sample.length;

      double variance = 0;

      for (final value in sample) {
        variance += pow(
          value - mean,
          2,
        ).toDouble();
      }

      variance /= sample.length;

      final deviation = sqrt(variance);

      upper.add(
        mean + deviation * 2,
      );

      lower.add(
        mean - deviation * 2,
      );
    }

    final upperPath = Path();
    final lowerPath = Path();

    for (int i = 0; i < upper.length; i++) {
      final x = xFor(i);

      if (i == 0) {
        upperPath.moveTo(
          x,
          yFor(upper[i]),
        );

        lowerPath.moveTo(
          x,
          yFor(lower[i]),
        );
      } else {
        upperPath.lineTo(
          x,
          yFor(upper[i]),
        );

        lowerPath.lineTo(
          x,
          yFor(lower[i]),
        );
      }
    }

    final paint = Paint()
      ..color = const Color(0xFF3F7BFF)
      ..strokeWidth = 1
      ..style = PaintingStyle.stroke;

    canvas.drawPath(
      upperPath,
      paint,
    );

    canvas.drawPath(
      lowerPath,
      paint,
    );
  }

  void _priceAxis(
    Canvas canvas,
    double chartWidth,
    double chartHeight,
    double minPrice,
    double maxPrice,
    double currentPrice,
    double currentY,
  ) {
    for (int i = 0; i <= 7; i++) {
      final y = chartHeight * i / 7;

      final price = maxPrice - ((maxPrice - minPrice) * i / 7);

      _text(
        canvas,
        price.toStringAsFixed(
          _decimals(price),
        ),
        Offset(
          chartWidth + 7,
          y - 7,
        ),
        Colors.white60,
        10,
      );
    }

    if (currentY >= 0 && currentY <= chartHeight) {
      canvas.drawRect(
        Rect.fromLTWH(
          chartWidth,
          currentY - 12,
          80,
          24,
        ),
        Paint()..color = const Color(0xFF438F80),
      );

      _text(
        canvas,
        currentPrice.toStringAsFixed(
          _decimals(currentPrice),
        ),
        Offset(
          chartWidth + 6,
          currentY - 8,
        ),
        Colors.white,
        11,
      );
    }

    if (crosshair != null &&
        crosshair!.dx <= chartWidth &&
        crosshair!.dy >= 0 &&
        crosshair!.dy <= chartHeight) {
      final price =
          maxPrice - ((crosshair!.dy / chartHeight) * (maxPrice - minPrice));

      canvas.drawRect(
        Rect.fromLTWH(
          chartWidth,
          crosshair!.dy - 11,
          80,
          22,
        ),
        Paint()..color = const Color(0xFF303743),
      );

      _text(
        canvas,
        price.toStringAsFixed(
          _decimals(price),
        ),
        Offset(
          chartWidth + 6,
          crosshair!.dy - 7,
        ),
        Colors.white,
        10,
      );
    }
  }

  void _timeAxis(
    Canvas canvas,
    double chartWidth,
    double chartHeight,
    List<_ChartCandle> data,
    double slot,
  ) {
    if (data.isEmpty) return;

    final step = max(
      1,
      data.length ~/ 6,
    );

    for (int i = 0; i < data.length; i += step) {
      final time = DateTime.fromMillisecondsSinceEpoch(
        data[i].time,
      );

      final label = '${time.hour.toString().padLeft(2, '0')}:'
          '${time.minute.toString().padLeft(2, '0')}';

      final x = slot * i + slot / 2;

      _text(
        canvas,
        label,
        Offset(
          x - 17,
          chartHeight + 8,
        ),
        Colors.white54,
        10,
      );
    }
  }

  int _decimals(double value) {
    if (value >= 1000) return 2;
    if (value >= 100) return 3;
    if (value >= 1) return 5;

    return 6;
  }

  void _text(
    Canvas canvas,
    String text,
    Offset position,
    Color color,
    double size,
  ) {
    final painter = TextPainter(
      text: TextSpan(
        text: text,
        style: TextStyle(
          color: color,
          fontSize: size,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();

    painter.paint(
      canvas,
      position,
    );
  }

  @override
  bool shouldRepaint(
    covariant _TradeChartPainter oldDelegate,
  ) {
    return true;
  }
}

enum _MarketFilter {
  all,
  forex,
  crypto,
  otc,
  nonOtc,
  favorites,
}

class _MarketPickerDialog extends StatefulWidget {
  final String? selectedSymbol;
  final Set<String> favorites;

  const _MarketPickerDialog({
    required this.selectedSymbol,
    required this.favorites,
  });

  @override
  State<_MarketPickerDialog> createState() => _MarketPickerDialogState();
}

class _MarketPickerDialogState extends State<_MarketPickerDialog> {
  final TextEditingController searchController = TextEditingController();

  _MarketFilter filter = _MarketFilter.all;
  late Set<String> favorites;

  @override
  void initState() {
    super.initState();
    favorites = Set<String>.from(widget.favorites);
  }

  @override
  void dispose() {
    widget.favorites
      ..clear()
      ..addAll(favorites);

    searchController.dispose();
    super.dispose();
  }

  bool _matchesFilter(String symbol) {
    switch (filter) {
      case _MarketFilter.forex:
        return MarketCatalog.isForex(symbol);

      case _MarketFilter.crypto:
        return MarketCatalog.isCrypto(symbol);

      case _MarketFilter.otc:
        return MarketCatalog.isOtc(symbol);

      case _MarketFilter.nonOtc:
        return !MarketCatalog.isOtc(symbol);

      case _MarketFilter.favorites:
        return favorites.contains(symbol);

      case _MarketFilter.all:
        return true;
    }
  }

  List<String> _filtered() {
    final query = searchController.text.trim().toUpperCase();

    return MarketCatalog.all.where((symbol) {
      if (!_matchesFilter(symbol)) return false;

      if (query.isEmpty) return true;

      return symbol.toUpperCase().contains(query);
    }).toList();
  }

  String _sectionFor(String symbol) {
    if (MarketCatalog.isOtc(symbol)) {
      if (symbol.startsWith('BTC') ||
          symbol.startsWith('ETH') ||
          symbol.startsWith('LTC') ||
          symbol.startsWith('BCH') ||
          symbol.startsWith('XRP')) {
        return 'CRYPTO OTC';
      }

      return 'FOREX OTC';
    }

    if (MarketCatalog.isForex(symbol)) {
      const majors = {
        'EURUSD',
        'GBPUSD',
        'USDJPY',
        'USDCHF',
        'USDCAD',
        'AUDUSD',
        'NZDUSD',
      };

      if (majors.contains(symbol)) {
        return 'FOREX MAJORS';
      }

      if (symbol.contains('MXN') ||
          symbol.contains('ZAR') ||
          symbol.contains('TRY') ||
          symbol.contains('SGD') ||
          symbol.contains('HKD') ||
          symbol.contains('NOK') ||
          symbol.contains('SEK') ||
          symbol.contains('PLN') ||
          symbol.contains('CNH')) {
        return 'FOREX EXOTICS';
      }

      return 'FOREX CROSSES';
    }

    if (MarketCatalog.isCrypto(symbol)) {
      if (symbol.endsWith('BTC') && symbol != 'BTCUSD' && symbol != 'BTCUSDT') {
        return 'CRYPTO BTC CROSSES';
      }

      const meme = {
        'DOGEUSD',
        'DOGEUSDT',
        'SHIBUSD',
        'SHIBUSDT',
        'PEPEUSD',
        'PEPEUSDT',
        'BONKUSD',
        'BONKUSDT',
        'FLOKIUSD',
        'FLOKIUSDT',
        'WIFUSD',
        'WIFUSDT',
      };

      if (meme.contains(symbol)) {
        return 'CRYPTO MEME';
      }

      const defi = {
        'UNIUSD',
        'UNIUSDT',
        'AAVEUSD',
        'AAVEUSDT',
        'MKRUSD',
        'MKRUSDT',
        'CRVUSD',
        'CRVUSDT',
        'COMPUSD',
        'COMPUSDT',
        'SNXUSD',
        'SNXUSDT',
        'LDOUSD',
        'LDOUSDT',
        'RUNEUSD',
        'RUNEUSDT',
      };

      if (defi.contains(symbol)) {
        return 'CRYPTO DEFI';
      }

      const majors = {
        'BTCUSD',
        'BTCUSDT',
        'ETHUSD',
        'ETHUSDT',
        'BNBUSD',
        'BNBUSDT',
        'SOLUSD',
        'SOLUSDT',
        'XRPUSD',
        'XRPUSDT',
        'ADAUSD',
        'ADAUSDT',
        'DOGEUSD',
        'DOGEUSDT',
      };

      if (majors.contains(symbol)) {
        return 'CRYPTO MAJORS';
      }

      return 'CRYPTO ALTCOINS';
    }

    return 'OTHER';
  }

  String _filterLabel(_MarketFilter value) {
    switch (value) {
      case _MarketFilter.all:
        return 'ALL';
      case _MarketFilter.forex:
        return 'FOREX';
      case _MarketFilter.crypto:
        return 'CRYPTO';
      case _MarketFilter.otc:
        return 'OTC';
      case _MarketFilter.nonOtc:
        return 'NON-OTC';
      case _MarketFilter.favorites:
        return 'FAVORITES';
    }
  }

  @override
  Widget build(BuildContext context) {
    final symbols = _filtered();

    final grouped = <String, List<String>>{};

    for (final symbol in symbols) {
      final section = _sectionFor(symbol);

      grouped.putIfAbsent(section, () => <String>[]).add(symbol);
    }

    const sectionOrder = [
      'FOREX MAJORS',
      'FOREX CROSSES',
      'FOREX EXOTICS',
      'CRYPTO MAJORS',
      'CRYPTO ALTCOINS',
      'CRYPTO DEFI',
      'CRYPTO MEME',
      'CRYPTO BTC CROSSES',
      'FOREX OTC',
      'CRYPTO OTC',
      'OTHER',
    ];

    return Dialog(
      backgroundColor: const Color(0xFF0C1019),
      child: SizedBox(
        width: 720,
        height: 720,
        child: Column(
          children: [
            Padding(
              padding: const EdgeInsets.all(16),
              child: TextField(
                controller: searchController,
                autofocus: true,
                onChanged: (_) => setState(() {}),
                decoration: const InputDecoration(
                  prefixIcon: Icon(Icons.search),
                  hintText: 'Search market or pair...',
                  border: OutlineInputBorder(),
                ),
              ),
            ),
            SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              padding: const EdgeInsets.symmetric(horizontal: 12),
              child: Row(
                children: _MarketFilter.values.map((value) {
                  final selected = filter == value;

                  return Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 3),
                    child: ChoiceChip(
                      selected: selected,
                      label: Text(_filterLabel(value)),
                      onSelected: (_) {
                        setState(() {
                          filter = value;
                        });
                      },
                    ),
                  );
                }).toList(),
              ),
            ),
            const SizedBox(height: 10),
            Expanded(
              child: symbols.isEmpty
                  ? const Center(
                      child: Text(
                        'No markets found.',
                        style: TextStyle(
                          color: Colors.white54,
                        ),
                      ),
                    )
                  : ListView(
                      children: [
                        for (final section in sectionOrder)
                          if (grouped[section]?.isNotEmpty ?? false) ...[
                            Container(
                              width: double.infinity,
                              padding: const EdgeInsets.fromLTRB(
                                16,
                                14,
                                16,
                                8,
                              ),
                              color: const Color(0xFF111725),
                              child: Text(
                                section,
                                style: const TextStyle(
                                  color: Color(0xFFAC8BFF),
                                  fontWeight: FontWeight.w900,
                                  fontSize: 12,
                                  letterSpacing: .7,
                                ),
                              ),
                            ),
                            for (final symbol in grouped[section]!)
                              ListTile(
                                selected: symbol == widget.selectedSymbol,
                                title: Text(
                                  symbol,
                                  style: const TextStyle(
                                    fontWeight: FontWeight.w800,
                                  ),
                                ),
                                subtitle: Text(
                                  MarketCatalog.isOtc(symbol)
                                      ? 'OTC MARKET'
                                      : 'STANDARD MARKET',
                                ),
                                trailing: IconButton(
                                  tooltip: favorites.contains(symbol)
                                      ? 'Remove favorite'
                                      : 'Add favorite',
                                  onPressed: () {
                                    setState(() {
                                      if (!favorites.remove(symbol)) {
                                        favorites.add(symbol);
                                      }
                                    });
                                  },
                                  icon: Icon(
                                    favorites.contains(symbol)
                                        ? Icons.star
                                        : Icons.star_border,
                                  ),
                                ),
                                onTap: () {
                                  Navigator.pop(context, symbol);
                                },
                              ),
                            const Divider(height: 1),
                          ],
                      ],
                    ),
            ),
          ],
        ),
      ),
    );
  }
}
