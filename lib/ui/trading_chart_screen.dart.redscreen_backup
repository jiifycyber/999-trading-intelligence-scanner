import 'dart:math';

import 'package:flutter/gestures.dart';
import 'package:flutter/material.dart';

import '../core/scanner_engine.dart';
import '../models/scan_result.dart';

class TradingChartScreen extends StatefulWidget {
  final ScannerEngine engine;

  const TradingChartScreen({
    super.key,
    required this.engine,
  });

  @override
  State<TradingChartScreen> createState() => _TradingChartScreenState();
}

class _TradingChartScreenState extends State<TradingChartScreen> {
  String timeframe = '1M';
  String? selectedSymbol;

  bool showEma9 = true;
  bool showEma21 = true;
  bool showBollinger = true;

  final List<_Candle> candles = [];

  double candlesVisible = 70;
  double panBars = 0;
  double verticalScale = 1.0;
  double verticalPan = 0;

  Offset? crosshair;

  double dragStartX = 0;
  double dragStartY = 0;
  double dragStartPanBars = 0;
  double dragStartVerticalPan = 0;

  double scaleStartVisible = 70;
  double scaleStartVertical = 1;

  int get bucketSeconds {
    switch (timeframe) {
      case '5M':
        return 300;
      case '15M':
        return 900;
      default:
        return 60;
    }
  }

  @override
  void initState() {
    super.initState();
    widget.engine.addListener(_engineChanged);
    _engineChanged();
  }

  @override
  void dispose() {
    widget.engine.removeListener(_engineChanged);
    super.dispose();
  }

  ScanResult? _currentResult() {
    final results = widget.engine.rankedResults;
    if (results.isEmpty) return null;

    selectedSymbol ??= results.first.symbol;

    for (final result in results) {
      if (result.symbol == selectedSymbol) return result;
    }

    selectedSymbol = results.first.symbol;
    return results.first;
  }

  void _engineChanged() {
    final result = _currentResult();

    if (result == null) {
      if (mounted) setState(() {});
      return;
    }

    final now = DateTime.now().millisecondsSinceEpoch;
    final bucketMs = bucketSeconds * 1000;
    final bucketStart = (now ~/ bucketMs) * bucketMs;

    if (candles.isEmpty || candles.last.time != bucketStart) {
      candles.add(
        _Candle(
          time: bucketStart,
          open: result.price,
          high: result.price,
          low: result.price,
          close: result.price,
        ),
      );
    } else {
      final c = candles.last;

      candles[candles.length - 1] = _Candle(
        time: c.time,
        open: c.open,
        high: max(c.high, result.price),
        low: min(c.low, result.price),
        close: result.price,
      );
    }

    if (candles.length > 2500) {
      candles.removeAt(0);
    }

    if (mounted) setState(() {});
  }

  void _changeTimeframe(String value) {
    setState(() {
      timeframe = value;
      candles.clear();
      panBars = 0;
      verticalScale = 1;
      verticalPan = 0;
      crosshair = null;
    });

    if (value == '5M') {
      widget.engine.setTimeframeSeconds(300);
    } else if (value == '15M') {
      widget.engine.setTimeframeSeconds(900);
    } else {
      widget.engine.setTimeframeSeconds(60);
    }

    _engineChanged();
  }

  void _resetView() {
    setState(() {
      candlesVisible = 70;
      panBars = 0;
      verticalScale = 1;
      verticalPan = 0;
      crosshair = null;
    });
  }

  void _clampPan() {
    final visibleCount = min(
      candlesVisible,
      candles.length.toDouble(),
    );

    final maxBack = max(
      0.0,
      candles.length.toDouble() - visibleCount,
    );

    panBars = panBars.clamp(0.0, maxBack).toDouble();
  }

  void _pointerSignal(PointerSignalEvent event) {
    if (event is! PointerScrollEvent) return;

    setState(() {
      if (event.scrollDelta.dy.abs() >= event.scrollDelta.dx.abs()) {
        final factor = event.scrollDelta.dy > 0 ? 1.12 : .88;
        candlesVisible = (candlesVisible * factor).clamp(8.0, 450.0);
      } else {
        panBars += event.scrollDelta.dx / 18;
      }

      _clampPan();
    });
  }

  void _panStart(DragStartDetails details) {
    dragStartX = details.localPosition.dx;
    dragStartY = details.localPosition.dy;
    dragStartPanBars = panBars;
    dragStartVerticalPan = verticalPan;
  }

  void _panUpdate(DragUpdateDetails details) {
    final width = context.size?.width ?? 900;

    final dx = details.localPosition.dx - dragStartX;
    final dy = details.localPosition.dy - dragStartY;

    setState(() {
      final barsPerPixel = candlesVisible / max(width, 1.0);

      panBars = dragStartPanBars + (-dx * barsPerPixel);
      verticalPan = dragStartVerticalPan + dy;
      crosshair = details.localPosition;

      _clampPan();
    });
  }

  void _scaleStart(ScaleStartDetails details) {
    scaleStartVisible = candlesVisible;
    scaleStartVertical = verticalScale;
  }

  void _scaleUpdate(ScaleUpdateDetails details) {
    if (details.scale == 1) return;

    setState(() {
      candlesVisible = (scaleStartVisible / details.scale).clamp(8.0, 450.0);

      verticalScale = (scaleStartVertical * details.scale).clamp(.35, 8.0);

      _clampPan();
    });
  }

  @override
  Widget build(BuildContext context) {
    final result = _currentResult();
    final results = widget.engine.rankedResults;

    return Scaffold(
      backgroundColor: const Color(0xFF070B12),
      appBar: AppBar(
        backgroundColor: const Color(0xFF0B1020),
        foregroundColor: Colors.white,
        elevation: 0,
        title: const Text(
          '999 TRADE X — CHARTS',
          style: TextStyle(
            fontWeight: FontWeight.w900,
            fontSize: 17,
          ),
        ),
        actions: [
          IconButton(
            tooltip: 'Reset chart',
            onPressed: _resetView,
            icon: const Icon(Icons.restart_alt),
          ),
        ],
      ),
      body: Column(
        children: [
          _chartToolbar(results),
          Expanded(
            child: result == null
                ? const Center(
                    child: Text(
                      'WAITING FOR MARKET DATA...',
                      style: TextStyle(
                        color: Colors.white54,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  )
                : _chartWorkspace(result),
          ),
        ],
      ),
    );
  }

  Widget _chartToolbar(List<ScanResult> results) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
      decoration: const BoxDecoration(
        color: Color(0xFF0B1020),
        border: Border(
          bottom: BorderSide(color: Color(0xFF242B42)),
        ),
      ),
      child: Wrap(
        spacing: 8,
        runSpacing: 8,
        crossAxisAlignment: WrapCrossAlignment.center,
        children: [
          const Icon(
            Icons.candlestick_chart,
            color: Color(0xFF9C6CFF),
          ),
          const Text(
            'ADVANCED CHART',
            style: TextStyle(
              color: Colors.white,
              fontWeight: FontWeight.w900,
            ),
          ),
          if (results.isNotEmpty)
            DropdownButton<String>(
              value: selectedSymbol,
              dropdownColor: const Color(0xFF11182A),
              underline: const SizedBox(),
              style: const TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.bold,
              ),
              items: results
                  .map(
                    (r) => DropdownMenuItem<String>(
                      value: r.symbol,
                      child: Text(r.symbol),
                    ),
                  )
                  .toList(),
              onChanged: (value) {
                if (value == null) return;

                setState(() {
                  selectedSymbol = value;
                  candles.clear();
                  panBars = 0;
                  crosshair = null;
                });

                _engineChanged();
              },
            ),
          _timeButton('1M'),
          _timeButton('5M'),
          _timeButton('15M'),
          _indicatorButton(
            'EMA 9',
            showEma9,
            () => setState(() => showEma9 = !showEma9),
          ),
          _indicatorButton(
            'EMA 21',
            showEma21,
            () => setState(() => showEma21 = !showEma21),
          ),
          _indicatorButton(
            'BOLL',
            showBollinger,
            () => setState(() => showBollinger = !showBollinger),
          ),
          IconButton(
            tooltip: 'Reset zoom',
            onPressed: _resetView,
            icon: const Icon(
              Icons.center_focus_strong,
              color: Colors.white70,
            ),
          ),
        ],
      ),
    );
  }

  Widget _timeButton(String value) {
    final active = timeframe == value;

    return InkWell(
      borderRadius: BorderRadius.circular(20),
      onTap: () => _changeTimeframe(value),
      child: Container(
        padding: const EdgeInsets.symmetric(
          horizontal: 14,
          vertical: 8,
        ),
        decoration: BoxDecoration(
          color: active ? const Color(0xFF6C35FF) : const Color(0xFF171E34),
          borderRadius: BorderRadius.circular(20),
        ),
        child: Text(
          value,
          style: TextStyle(
            color: active ? Colors.white : Colors.white60,
            fontWeight: FontWeight.w900,
          ),
        ),
      ),
    );
  }

  Widget _indicatorButton(
    String text,
    bool enabled,
    VoidCallback onTap,
  ) {
    return OutlinedButton(
      onPressed: onTap,
      style: OutlinedButton.styleFrom(
        foregroundColor: enabled ? Colors.white : Colors.white38,
        side: BorderSide(
          color: enabled ? const Color(0xFF9C6CFF) : const Color(0xFF343B50),
        ),
      ),
      child: Text(text),
    );
  }

  Widget _chartWorkspace(ScanResult result) {
    return Column(
      children: [
        _marketHeader(result),
        Expanded(
          child: Container(
            margin: const EdgeInsets.fromLTRB(12, 4, 12, 12),
            decoration: BoxDecoration(
              color: const Color(0xFF080D16),
              borderRadius: BorderRadius.circular(10),
              border: Border.all(
                color: const Color(0xFF27304A),
              ),
            ),
            clipBehavior: Clip.antiAlias,
            child: MouseRegion(
              onHover: (event) {
                setState(() => crosshair = event.localPosition);
              },
              onExit: (_) {
                setState(() => crosshair = null);
              },
              child: Listener(
                onPointerSignal: _pointerSignal,
                child: GestureDetector(
                  behavior: HitTestBehavior.opaque,
                  onPanStart: _panStart,
                  onPanUpdate: _panUpdate,
                  onScaleStart: _scaleStart,
                  onScaleUpdate: _scaleUpdate,
                  onDoubleTap: _resetView,
                  onTapDown: (details) {
                    setState(() => crosshair = details.localPosition);
                  },
                  child: LayoutBuilder(
                    builder: (context, constraints) {
                      return CustomPaint(
                        size: Size(
                          constraints.maxWidth,
                          constraints.maxHeight,
                        ),
                        painter: _TradingChartPainter(
                          candles: candles,
                          candlesVisible: candlesVisible,
                          panBars: panBars,
                          verticalScale: verticalScale,
                          verticalPan: verticalPan,
                          crosshair: crosshair,
                          showEma9: showEma9,
                          showEma21: showEma21,
                          showBollinger: showBollinger,
                        ),
                      );
                    },
                  ),
                ),
              ),
            ),
          ),
        ),
        Container(
          width: double.infinity,
          padding: const EdgeInsets.fromLTRB(16, 0, 16, 10),
          child: const Text(
            'SCROLL / PINCH = ZOOM • DRAG LEFT/RIGHT = TIME • DRAG UP/DOWN = PRICE • DOUBLE CLICK = RESET',
            style: TextStyle(
              color: Colors.white38,
              fontSize: 10,
              fontWeight: FontWeight.w600,
            ),
          ),
        ),
      ],
    );
  }

  Widget _marketHeader(ScanResult result) {
    Color signalColor;

    switch (result.side) {
      case SignalSide.call:
        signalColor = const Color(0xFF38D996);
        break;
      case SignalSide.put:
        signalColor = const Color(0xFFFF5964);
        break;
      default:
        signalColor = const Color(0xFFFFC857);
    }

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.symmetric(
        horizontal: 16,
        vertical: 10,
      ),
      decoration: const BoxDecoration(
        color: Color(0xFF090E18),
        border: Border(
          bottom: BorderSide(
            color: Color(0xFF1B2438),
          ),
        ),
      ),
      child: Row(
        children: [
          Text(
            result.symbol,
            style: const TextStyle(
              color: Colors.white,
              fontWeight: FontWeight.w900,
              fontSize: 16,
            ),
          ),
          const SizedBox(width: 12),
          Text(
            result.price.toStringAsFixed(5),
            style: const TextStyle(
              color: Color(0xFF3EE6B0),
              fontWeight: FontWeight.w900,
              fontSize: 15,
            ),
          ),
          const SizedBox(width: 12),
          Text(
            result.side.name.toUpperCase(),
            style: TextStyle(
              color: signalColor,
              fontWeight: FontWeight.w900,
            ),
          ),
          const SizedBox(width: 8),
          Text(
            '${result.score}/100',
            style: const TextStyle(
              color: Colors.white60,
              fontWeight: FontWeight.bold,
            ),
          ),
          const Spacer(),
          Text(
            '$timeframe • LIVE',
            style: const TextStyle(
              color: Colors.white60,
              fontWeight: FontWeight.w800,
            ),
          ),
          const SizedBox(width: 16),
          Text(
            '${candles.length} CANDLES',
            style: const TextStyle(
              color: Colors.white38,
              fontSize: 11,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }
}

class _Candle {
  final int time;
  final double open;
  final double high;
  final double low;
  final double close;

  const _Candle({
    required this.time,
    required this.open,
    required this.high,
    required this.low,
    required this.close,
  });
}

class _TradingChartPainter extends CustomPainter {
  final List<_Candle> candles;

  final double candlesVisible;
  final double panBars;
  final double verticalScale;
  final double verticalPan;

  final Offset? crosshair;

  final bool showEma9;
  final bool showEma21;
  final bool showBollinger;

  _TradingChartPainter({
    required this.candles,
    required this.candlesVisible,
    required this.panBars,
    required this.verticalScale,
    required this.verticalPan,
    required this.crosshair,
    required this.showEma9,
    required this.showEma21,
    required this.showBollinger,
  });

  @override
  void paint(Canvas canvas, Size size) {
    canvas.drawRect(
      Offset.zero & size,
      Paint()..color = const Color(0xFF080D16),
    );

    if (candles.isEmpty) {
      _drawText(
        canvas,
        'WAITING FOR MARKET DATA...',
        Offset(size.width / 2 - 90, size.height / 2),
        Colors.white38,
        12,
      );
      return;
    }

    const priceAxisWidth = 78.0;
    const timeAxisHeight = 30.0;

    final chartWidth = max(
      1.0,
      size.width - priceAxisWidth,
    );

    final chartHeight = max(
      1.0,
      size.height - timeAxisHeight,
    );

    final chartRect = Rect.fromLTWH(
      0,
      0,
      chartWidth,
      chartHeight,
    );

    // -----------------------------------------------------
    // VISIBLE CANDLE WINDOW
    // -----------------------------------------------------

    final requested = candlesVisible.round().clamp(2, max(2, candles.length));

    final rawEnd = candles.length - panBars.round();

    final end = rawEnd
        .clamp(
          1,
          candles.length,
        )
        .toInt();

    final start = max(
      0,
      end - requested,
    ).toInt();

    final visible = candles.sublist(
      start,
      end,
    );

    if (visible.isEmpty) return;

    // -----------------------------------------------------
    // PRICE RANGE
    // -----------------------------------------------------

    double rawMin = visible.first.low;
    double rawMax = visible.first.high;

    for (final candle in visible) {
      rawMin = min(rawMin, candle.low);
      rawMax = max(rawMax, candle.high);
    }

    if ((rawMax - rawMin).abs() < 0.0000001) {
      final expansion = max(rawMax.abs() * .001, .0001);

      rawMax += expansion;
      rawMin -= expansion;
    }

    final rawRange = rawMax - rawMin;

    final pricePerPixel = rawRange / chartHeight;

    final shiftedCenter =
        ((rawMax + rawMin) / 2) + (verticalPan * pricePerPixel);

    final scaledRange = rawRange / max(verticalScale, .05);

    final padding = scaledRange * .10;

    final minPrice = shiftedCenter - scaledRange / 2 - padding;

    final maxPrice = shiftedCenter + scaledRange / 2 + padding;

    final priceRange = maxPrice - minPrice;

    double yFor(double price) {
      return chartHeight - ((price - minPrice) / priceRange) * chartHeight;
    }

    final slot = chartWidth / max(visible.length, 1);

    double xFor(int i) {
      return slot * i + slot / 2;
    }

    // -----------------------------------------------------
    // CHART CLIP
    // -----------------------------------------------------

    canvas.save();
    canvas.clipRect(chartRect);

    _drawGrid(
      canvas,
      chartWidth,
      chartHeight,
    );

    // -----------------------------------------------------
    // INDICATORS
    // -----------------------------------------------------

    if (showBollinger) {
      _drawBollinger(
        canvas,
        visible,
        xFor,
        yFor,
      );
    }

    if (showEma21) {
      _drawEma(
        canvas,
        visible,
        21,
        xFor,
        yFor,
        const Color(0xFFFFA726),
      );
    }

    if (showEma9) {
      _drawEma(
        canvas,
        visible,
        9,
        xFor,
        yFor,
        const Color(0xFF9C6CFF),
      );
    }

    // -----------------------------------------------------
    // CANDLES
    // -----------------------------------------------------

    final bodyWidth = (slot * .66).clamp(2.0, 18.0).toDouble();

    for (int i = 0; i < visible.length; i++) {
      final candle = visible[i];

      final bullish = candle.close >= candle.open;

      final color = bullish ? const Color(0xFF3ED598) : const Color(0xFFFF5964);

      final x = xFor(i);

      final openY = yFor(candle.open);
      final closeY = yFor(candle.close);
      final highY = yFor(candle.high);
      final lowY = yFor(candle.low);

      final candlePaint = Paint()
        ..color = color
        ..strokeWidth = 1.2;

      canvas.drawLine(
        Offset(x, highY),
        Offset(x, lowY),
        candlePaint,
      );

      final top = min(openY, closeY);

      final bottom = max(openY, closeY);

      canvas.drawRect(
        Rect.fromLTRB(
          x - bodyWidth / 2,
          top,
          x + bodyWidth / 2,
          max(top + 1.5, bottom),
        ),
        candlePaint,
      );
    }

    // -----------------------------------------------------
    // CURRENT PRICE LINE
    // -----------------------------------------------------

    final currentPrice = visible.last.close;

    final currentY = yFor(currentPrice);

    if (currentY >= 0 && currentY <= chartHeight) {
      final pricePaint = Paint()
        ..color = const Color(0xFF42D7B5)
        ..strokeWidth = 1;

      for (double x = 0; x < chartWidth; x += 10) {
        canvas.drawLine(
          Offset(x, currentY),
          Offset(
            min(x + 5, chartWidth),
            currentY,
          ),
          pricePaint,
        );
      }
    }

    // -----------------------------------------------------
    // CROSSHAIR
    // -----------------------------------------------------

    if (crosshair != null &&
        crosshair!.dx >= 0 &&
        crosshair!.dx <= chartWidth &&
        crosshair!.dy >= 0 &&
        crosshair!.dy <= chartHeight) {
      final crossPaint = Paint()
        ..color = Colors.white.withValues(alpha: .42)
        ..strokeWidth = .8;

      canvas.drawLine(
        Offset(crosshair!.dx, 0),
        Offset(
          crosshair!.dx,
          chartHeight,
        ),
        crossPaint,
      );

      canvas.drawLine(
        Offset(0, crosshair!.dy),
        Offset(
          chartWidth,
          crosshair!.dy,
        ),
        crossPaint,
      );
    }

    canvas.restore();

    // -----------------------------------------------------
    // RIGHT PRICE SCALE
    // -----------------------------------------------------

    _drawPriceScale(
      canvas,
      chartWidth,
      chartHeight,
      minPrice,
      maxPrice,
      currentPrice,
      currentY,
    );

    // -----------------------------------------------------
    // BOTTOM TIME SCALE
    // -----------------------------------------------------

    _drawTimeScale(
      canvas,
      chartWidth,
      chartHeight,
      visible,
      slot,
    );

    // -----------------------------------------------------
    // CROSSHAIR LABELS
    // -----------------------------------------------------

    if (crosshair != null &&
        crosshair!.dx >= 0 &&
        crosshair!.dx <= chartWidth &&
        crosshair!.dy >= 0 &&
        crosshair!.dy <= chartHeight) {
      final hoverPrice =
          maxPrice - ((crosshair!.dy / chartHeight) * priceRange);

      canvas.drawRect(
        Rect.fromLTWH(
          chartWidth,
          crosshair!.dy - 11,
          priceAxisWidth,
          22,
        ),
        Paint()..color = const Color(0xFF313746),
      );

      _drawText(
        canvas,
        hoverPrice.toStringAsFixed(
          _priceDecimals(hoverPrice),
        ),
        Offset(
          chartWidth + 5,
          crosshair!.dy - 7,
        ),
        Colors.white,
        11,
      );
    }
  }

  void _drawGrid(
    Canvas canvas,
    double width,
    double height,
  ) {
    final paint = Paint()
      ..color = Colors.white.withValues(alpha: .065)
      ..strokeWidth = 1;

    const rows = 7;
    const columns = 10;

    for (int i = 0; i <= rows; i++) {
      final y = height * i / rows;

      canvas.drawLine(
        Offset(0, y),
        Offset(width, y),
        paint,
      );
    }

    for (int i = 0; i <= columns; i++) {
      final x = width * i / columns;

      canvas.drawLine(
        Offset(x, 0),
        Offset(x, height),
        paint,
      );
    }
  }

  void _drawEma(
    Canvas canvas,
    List<_Candle> data,
    int period,
    double Function(int) xFor,
    double Function(double) yFor,
    Color color,
  ) {
    if (data.length < 2) return;

    final closes = data.map((e) => e.close).toList();

    final ema = _emaValues(closes, period);

    final path = Path();

    for (int i = 0; i < ema.length; i++) {
      final x = xFor(i);
      final y = yFor(ema[i]);

      if (i == 0) {
        path.moveTo(x, y);
      } else {
        path.lineTo(x, y);
      }
    }

    canvas.drawPath(
      path,
      Paint()
        ..color = color
        ..strokeWidth = 1.5
        ..style = PaintingStyle.stroke,
    );
  }

  List<double> _emaValues(
    List<double> values,
    int period,
  ) {
    if (values.isEmpty) return [];

    final result = <double>[];
    final k = 2 / (period + 1);

    double ema = values.first;

    for (final value in values) {
      ema = value * k + ema * (1 - k);

      result.add(ema);
    }

    return result;
  }

  void _drawBollinger(
    Canvas canvas,
    List<_Candle> data,
    double Function(int) xFor,
    double Function(double) yFor,
  ) {
    if (data.length < 2) return;

    final closes = data.map((e) => e.close).toList();

    final upper = <double>[];
    final lower = <double>[];

    for (int i = 0; i < closes.length; i++) {
      final begin = max(0, i - 19);

      final window = closes.sublist(begin, i + 1);

      final mean = window.reduce((a, b) => a + b) / window.length;

      double variance = 0;

      for (final value in window) {
        variance += pow(value - mean, 2).toDouble();
      }

      variance /= window.length;

      final deviation = sqrt(variance);

      upper.add(
        mean + deviation * 2,
      );

      lower.add(
        mean - deviation * 2,
      );
    }

    final upperPath = Path();
    final lowerPath = Path();

    for (int i = 0; i < upper.length; i++) {
      final x = xFor(i);

      if (i == 0) {
        upperPath.moveTo(
          x,
          yFor(upper[i]),
        );

        lowerPath.moveTo(
          x,
          yFor(lower[i]),
        );
      } else {
        upperPath.lineTo(
          x,
          yFor(upper[i]),
        );

        lowerPath.lineTo(
          x,
          yFor(lower[i]),
        );
      }
    }

    final paint = Paint()
      ..color = const Color(0xFF3D7CFF)
      ..strokeWidth = 1
      ..style = PaintingStyle.stroke;

    canvas.drawPath(
      upperPath,
      paint,
    );

    canvas.drawPath(
      lowerPath,
      paint,
    );
  }

  void _drawPriceScale(
    Canvas canvas,
    double chartWidth,
    double chartHeight,
    double minPrice,
    double maxPrice,
    double currentPrice,
    double currentY,
  ) {
    const levels = 7;

    for (int i = 0; i <= levels; i++) {
      final y = chartHeight * i / levels;

      final price = maxPrice - ((maxPrice - minPrice) * i / levels);

      _drawText(
        canvas,
        price.toStringAsFixed(
          _priceDecimals(price),
        ),
        Offset(
          chartWidth + 7,
          y - 7,
        ),
        Colors.white60,
        10,
      );
    }

    if (currentY >= 0 && currentY <= chartHeight) {
      canvas.drawRect(
        Rect.fromLTWH(
          chartWidth,
          currentY - 12,
          78,
          24,
        ),
        Paint()..color = const Color(0xFF3F9B87),
      );

      _drawText(
        canvas,
        currentPrice.toStringAsFixed(
          _priceDecimals(currentPrice),
        ),
        Offset(
          chartWidth + 5,
          currentY - 8,
        ),
        Colors.white,
        11,
      );
    }
  }

  void _drawTimeScale(
    Canvas canvas,
    double chartWidth,
    double chartHeight,
    List<_Candle> data,
    double slot,
  ) {
    if (data.isEmpty) return;

    final step = max(1, data.length ~/ 6);

    for (int i = 0; i < data.length; i += step) {
      final date = DateTime.fromMillisecondsSinceEpoch(
        data[i].time,
      );

      final label = '${date.hour.toString().padLeft(2, '0')}:'
          '${date.minute.toString().padLeft(2, '0')}';

      final x = slot * i + slot / 2;

      _drawText(
        canvas,
        label,
        Offset(
          x - 17,
          chartHeight + 8,
        ),
        Colors.white54,
        10,
      );
    }
  }

  int _priceDecimals(double price) {
    if (price >= 1000) return 2;
    if (price >= 100) return 3;
    if (price >= 1) return 5;

    return 6;
  }

  void _drawText(
    Canvas canvas,
    String text,
    Offset offset,
    Color color,
    double fontSize,
  ) {
    final painter = TextPainter(
      text: TextSpan(
        text: text,
        style: TextStyle(
          color: color,
          fontSize: fontSize,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();

    painter.paint(
      canvas,
      offset,
    );
  }

  @override
  bool shouldRepaint(
    covariant _TradingChartPainter oldDelegate,
  ) {
    return true;
  }
}
